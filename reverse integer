class Solution:
    def reverse(self, x: int) -> int:
        ans = 0
        if(x>0):
           n=x
        else:
            n=-x
        while(n>0):
           rem = n%10
           ans = (ans*10)+rem
           n//=10
        if(x<0):
            ans = -ans 
        if(ans<-(2**31)or ans>(2**31)-1):
            return 0
        return ans        

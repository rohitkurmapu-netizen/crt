class Solution:
    def countGoodSubstrings(self, s: str) -> int:
        count = 0
        i=0
        j=0
        while(j<len(s)):
            if((j-i+1)<3):
              j+=1
            elif((j-i+1)==3):
                if((s[i]!=s[j])and(s[i]!=s[i+1])and(s[i+1]!=s[j])):
                    count+=1
                i+=1
                j+=1
        return count
